# Google Analytics
# Get your Google Analytics ID from https://analytics.google.com
NEXT_PUBLIC_GOOGLE_ANALYTICS=G_XXXXXXXXXX

# Cloudinary Configuration
# Sign up at https://cloudinary.com and get your credentials
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Resend Configuration (contact form emails)
# Get your API key at https://resend.com/api-keys
# Without a verified domain, the default onboarding@resend.dev sender can
# only deliver to the email address your Resend account was created with.
RESEND_API_KEY=your_resend_api_key

# Hotjar Configuration (optional)
# Set up at https://www.hotjar.com for user analytics
NEXT_PUBLIC_HOTJAR_ID=your_hotjar_id
NEXT_PUBLIC_HOTJAR_SNIPPET_VERSION=6
