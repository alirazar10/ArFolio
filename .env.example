# Google Analytics
# Get your Google Analytics ID from https://analytics.google.com
NEXT_PUBLIC_GOOGLE_ANALYTICS=G_XXXXXXXXXX

# Cloudinary Configuration
# Sign up at https://cloudinary.com and get your credentials
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Formspree Configuration (optional)
# Set up at https://formspree.io for contact form emails
FORMSPREE_FORM_ID=your_formspree_id

# Hotjar Configuration (optional)
# Set up at https://www.hotjar.com for user analytics
NEXT_PUBLIC_HOTJAR_ID=your_hotjar_id
NEXT_PUBLIC_HOTJAR_SNIPPET_VERSION=6
